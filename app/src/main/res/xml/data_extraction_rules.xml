<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Le journal reste local et exportable seulement via l'interface ASTRA. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
