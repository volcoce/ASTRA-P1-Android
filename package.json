{
  "name": "astra-public-runtime",
  "private": true,
  "version": "0.8.11-preview",
  "description": "ASTRA runtime astronomical engine — no personal ephemeris tables",
  "scripts": {
    "bundle": "esbuild astro/runtime.mjs --bundle --minify --format=iife --target=es2020 --outfile=app/src/main/assets/runtime.bundle.js",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run bundle && node scripts/dev-server.mjs",
    "test:desktop": "node --test tests/dev-server.test.mjs"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
