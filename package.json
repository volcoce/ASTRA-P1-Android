{
  "name": "astra-public-runtime",
  "private": true,
  "version": "0.8.17-preview",
  "description": "ASTRA runtime astronomical engine — no personal ephemeris tables",
  "scripts": {
    "bundle": "npm run bundle:js && npm run build:css",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run bundle && node scripts/dev-server.mjs",
    "test:desktop": "node --test tests/dev-server.test.mjs",
    "bundle:js": "esbuild astro/runtime.mjs --bundle --minify --format=iife --target=es2020 --outfile=app/src/main/assets/runtime.bundle.js",
    "build:css": "node scripts/build-css.mjs",
    "lint:css": "stylelint 'app/src/main/assets/*.css' && node --test tests/css-ownership.test.mjs tests/css-debt.test.mjs",
    "check:css": "npm run lint:css && npm run build:css",
    "test:ui": "python tests/ui-smoke.py && python tests/ui-referential.py && python tests/ui-catalog.py",
    "dev:ui": "npm run build:css && node scripts/dev-server.mjs"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "esbuild": "0.25.12",
    "postcss": "8.5.33",
    "stylelint": "18.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
